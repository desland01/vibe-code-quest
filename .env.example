# Vibe Code Quest — example environment
#
# Copy to .env.local and fill in what you need:  cp .env.example .env.local
# .env.local is gitignored. Never commit real values.
#
# NOTHING HERE IS REQUIRED to play. With no .env.local at all the app runs in
# self-host mode: every landmark, beat, quiz and stamp works, progress is saved
# in the browser only, and the surfaces that need shared server state
# (leaderboard, share cards, cross-device resume, email save, XP HUD) are hidden.


# ─── Database (enables hosted mode) ──────────────────────────────────────────
# Postgres. The hosted instance runs Neon. Setting DATABASE_URL is what switches
# the app from self-host mode to hosted mode.

# Pooled connection string used by the application at runtime.
DATABASE_URL=

# Direct (unpooled) connection. Used ONLY by `npm run db:migrate`.
DATABASE_URL_UNPOOLED=

# Optional. A throwaway database for the DB-backed test suites. When unset those
# tests skip themselves, so `npm run test` stays green on a clean clone.
# Never point this at a database you care about — the suites write to it.
TEST_DATABASE_URL=


# ─── Sessions ────────────────────────────────────────────────────────────────

# Signing key for anonymous session tokens (HS256). Required in hosted mode.
# Generate one with:  openssl rand -base64 32
# Rotating it signs every existing visitor out.
AUTH_SECRET=

# How one-time passcodes for the optional "save progress via email" flow are
# delivered. Leave unset for local development, where codes are logged instead
# of emailed.
OTP_EMAIL_TRANSPORT=


# ─── AI guide (entirely optional) ────────────────────────────────────────────
# The guide is a side rail, never a gate. With no key it serves the canonical
# landmark text and every landmark still completes.

# Vercel AI Gateway key. Bring your own — you pay for your own usage.
AI_GATEWAY_API_KEY=

# Model ids as the gateway spells them. Note the gateway uses DOTS in version
# numbers (openai/gpt-5.6-luna), not dashes. An unknown id fails the request and
# silently degrades the guide to offline text, so check these carefully against
#   curl https://ai-gateway.vercel.sh/v1/models
#
# executor = every guide turn. advisor = escalation only (cross-region questions
# or low-confidence answers, capped per session). fallback = one retry after a
# rate limit.
AI_MODEL_EXECUTOR=
AI_MODEL_ADVISOR=
AI_MODEL_FALLBACK=

# Shared secret for the signed failure-drill harness, which lets a canary force
# gateway 429/5xx responses to prove the offline path. Non-production only.
AI_DRILL_SECRET=


# ─── AI usage caps ───────────────────────────────────────────────────────────
# All optional — each has a conservative built-in default. Every value is a
# token count. The access seam reserves the worst case up front and reconciles
# against actual usage afterwards, so a burst cannot overshoot a cap.
#
# Set any cap to 0 to switch that surface off entirely.

# Per-request budget per surface: worst case reserved, and the hard ceiling.
ACCESS_ONBOARDING_WORST_CASE_TOKENS=
ACCESS_ONBOARDING_REQUEST_TOKEN_CEILING=
ACCESS_GUIDE_WORST_CASE_TOKENS=
ACCESS_GUIDE_REQUEST_TOKEN_CEILING=
ACCESS_RENDERER_WORST_CASE_TOKENS=
ACCESS_RENDERER_REQUEST_TOKEN_CEILING=

# Daily ceiling per profile, by tier. Nothing writes entitlements any more —
# the product is free — so every profile resolves to anonymous or free.
ACCESS_IDENTITY_DAILY_TOKENS_ANONYMOUS=
ACCESS_IDENTITY_DAILY_TOKENS_FREE=
ACCESS_IDENTITY_DAILY_TOKENS_TRIAL=
ACCESS_IDENTITY_DAILY_TOKENS_ACTIVE=

# Whole-service daily ceiling. This is the backstop that bounds your bill.
ACCESS_GLOBAL_DAILY_TOKENS=

# Abuse throttles for anonymous visitors. Keys are hashed, never stored raw.
ACCESS_ANONYMOUS_IP_DAILY_TOKENS=
ACCESS_ANONYMOUS_DEVICE_DAILY_TOKENS=

# How long an unreconciled reservation is held before it expires and its tokens
# are returned to the pool.
ACCESS_RESERVATION_TTL_SECONDS=
