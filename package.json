{
  "name": "code-tutor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:manifest -- --forbid-drafts && next build",
    "build:manifest": "node --experimental-strip-types scripts/build-manifest.ts",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gate:prepush": "npm run test:db",
    "test:db": "node scripts/with-neon-branch.mjs vitest run --no-file-parallelism src/__tests__/*.integration.test.ts",
    "check:models": "node scripts/check-gateway-models.mjs",
    "test:e2e": "playwright test",
    "test:rls": "sh -c 'test -n \"$TEST_DATABASE_URL\" || { echo \"TEST_DATABASE_URL is required for npm run test:rls\" >&2; exit 1; }; vitest run src/__tests__/rls.integration.test.ts'",
    "db:migrate": "node --experimental-strip-types db/migrate.ts"
  },
  "dependencies": {
    "ai": "^6.0.230",
    "dotenv": "^17.2.3",
    "jose": "^6.1.0",
    "next": "^16.2.6",
    "pg": "^8.16.3",
    "pixi.js": "^8.14.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/eslintrc": "^3.3.3",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.4",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  }
}
